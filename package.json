{
  "name": "learnling",
  "version": "0.3.1",
  "private": true,
  "description": "Learnling — a two-week homework planner with a study buddy",
  "main": "./out/main/index.js",
  "author": "Jeroen Stengs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "pack": "electron-vite build && electron-builder --dir --publish never",
    "dist": "electron-vite build && electron-builder --publish never",
    "icon": "electron scripts/make-icon.js",
    "site": "vite-node site/build.ts"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "nl.jeroenstengs.learnling",
    "productName": "Learnling",
    "copyright": "© 2026 Jeroen Stengs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/icon.ico",
      "resources/icon.png"
    ],
    "afterPack": "./scripts/brand.js",
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Learnling",
      "artifactName": "Learnling-Setup-${version}.${ext}",
      "uninstallDisplayName": "Learnling",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bhalial",
        "repo": "learnling",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
